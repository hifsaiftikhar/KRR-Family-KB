    <!-- LISTS -->
    <category>
        <pattern>LIST ALL MALES</pattern>
        <template>QUERY:list_males|</template>
    </category>
    <category>
        <pattern>SHOW ALL MALES</pattern>
        <template>QUERY:list_males|</template>

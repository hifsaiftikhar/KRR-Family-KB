<?xml version="1.0" encoding="UTF-8"?>
<aiml version="1.0.1" encoding="UTF-8">

    <!-- GREETINGS -->
    <category>
        <pattern>HELLO</pattern>
        <template>Hello! I am the Neo4j Graph-based Family Chatbot. Ask me relationship queries or tell me new facts. Type HELP to see options.</template>
    </category>
    <category>
        <pattern>HI</pattern>
        <template><srai>HELLO</srai></template>
    </category>
    <category>
        <pattern>HEY</pattern>
        <template><srai>HELLO</srai></template>
    </category>
    <category>
        <pattern>HELP</pattern>
        <template>You can teach me:
- John is a male
- Mary is a female
- Ali is the father of Hassan
- Fatima is the mother of Hassan
- Ali is married to Fatima
- Ali was born in 1950

Then ask me:
- Who is the father of Hassan?
- Who are the ancestors of Usman?
- Who are the cousins of Bilal?
- Is Hassan married?
- Is Hassan older than Usman?
- List all males
- stats (graph statistics)
- hybrid (Prolog reasoning)</template>
    </category>

    <!-- =====================================================
         LEARNING PATTERNS — returns LEARN: token
         Python reads this and writes to Neo4j
    ===================================================== -->

    <!-- GENDER -->
    <category>
        <pattern>* IS A MALE</pattern>
        <template>LEARN:gender|<star/>|male</template>
    </category>
    <category>
        <pattern>* IS MALE</pattern>
        <template>LEARN:gender|<star/>|male</template>
    </category>
    <category>
        <pattern>* IS A MAN</pattern>
        <template>LEARN:gender|<star/>|male</template>
    </category>
    <category>
        <pattern>* IS A BOY</pattern>
        <template>LEARN:gender|<star/>|male</template>
    </category>
    <category>
        <pattern>* IS A FEMALE</pattern>
        <template>LEARN:gender|<star/>|female</template>
    </category>
    <category>
        <pattern>* IS FEMALE</pattern>
        <template>LEARN:gender|<star/>|female</template>
    </category>
    <category>
        <pattern>* IS A WOMAN</pattern>
        <template>LEARN:gender|<star/>|female</template>
    </category>
    <category>
        <pattern>* IS A GIRL</pattern>
        <template>LEARN:gender|<star/>|female</template>
    </category>

    <!-- PARENT -->
    <category>
        <pattern>* IS THE FATHER OF *</pattern>
        <template>LEARN:parent|<star index="1"/>|<star index="2"/>|father</template>
    </category>
    <category>
        <pattern>* IS FATHER OF *</pattern>
        <template>LEARN:parent|<star index="1"/>|<star index="2"/>|father</template>
    </category>
    <category>
        <pattern>* IS THE MOTHER OF *</pattern>
        <template>LEARN:parent|<star index="1"/>|<star index="2"/>|mother</template>
    </category>
    <category>
        <pattern>* IS MOTHER OF *</pattern>
        <template>LEARN:parent|<star index="1"/>|<star index="2"/>|mother</template>
    </category>
    <category>
        <pattern>* IS A PARENT OF *</pattern>
        <template>LEARN:parent|<star index="1"/>|<star index="2"/>|parent</template>
    </category>
    <category>
        <pattern>* IS PARENT OF *</pattern>
        <template>LEARN:parent|<star index="1"/>|<star index="2"/>|parent</template>
    </category>
    <category>
        <pattern>* IS THE SON OF *</pattern>
        <template>LEARN:parent|<star index="2"/>|<star index="1"/>|parent</template>
    </category>
    <category>
        <pattern>* IS THE DAUGHTER OF *</pattern>
        <template>LEARN:parent|<star index="2"/>|<star index="1"/>|parent</template>
    </category>
    <category>
        <pattern>* IS SON OF *</pattern>
        <template>LEARN:parent|<star index="2"/>|<star index="1"/>|parent</template>
    </category>
    <category>
        <pattern>* IS DAUGHTER OF *</pattern>
        <template>LEARN:parent|<star index="2"/>|<star index="1"/>|parent</template>
    </category>

    <!-- MARRIAGE -->
    <category>
        <pattern>* IS MARRIED TO *</pattern>
        <template>LEARN:married|<star index="1"/>|<star index="2"/></template>
    </category>
    <category>
        <pattern>* MARRIED *</pattern>
        <template>LEARN:married|<star index="1"/>|<star index="2"/></template>
    </category>
    <category>
        <pattern>* IS THE HUSBAND OF *</pattern>
        <template>LEARN:married|<star index="1"/>|<star index="2"/></template>
    </category>
    <category>
        <pattern>* IS THE WIFE OF *</pattern>
        <template>LEARN:married|<star index="2"/>|<star index="1"/></template>
    </category>

    <!-- DOB -->
    <category>
        <pattern>* WAS BORN IN *</pattern>
        <template>LEARN:dob|<star index="1"/>|<star index="2"/></template>
    </category>
    <category>
        <pattern>* WAS BORN *</pattern>
        <template>LEARN:dob|<star index="1"/>|<star index="2"/></template>
    </category>
    <category>
        <pattern>* IS BORN IN *</pattern>
        <template>LEARN:dob|<star index="1"/>|<star index="2"/></template>
    </category>
    <category>
        <pattern>DATE OF BIRTH OF * IS *</pattern>
        <template>LEARN:dob|<star index="1"/>|<star index="2"/></template>
    </category>


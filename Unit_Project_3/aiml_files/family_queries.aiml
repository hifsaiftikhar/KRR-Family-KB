    <!-- MUTUAL CONNECTIONS -->
    <category>
        <pattern>WHAT ARE THE MUTUAL CONNECTIONS BETWEEN * AND *</pattern>
        <template>QUERY:mutual|<star index="1"/>|<star index="2"/></template>
    </category>
    <category>
        <pattern>WHAT DO * AND * HAVE IN COMMON</pattern>
        <template>QUERY:mutual|<star index="1"/>|<star index="2"/></template>
    </category>

    <!-- FALLBACK -->
    <category>
        <pattern>*</pattern>
        <template>I did not understand that. Try: Ali is a male. Or: Who is the father of Hassan? Type HELP for all options.</template>
    </category>

</aiml>

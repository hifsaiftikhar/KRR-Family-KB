    </category>

    <!-- FALLBACK -->
    <category>
        <pattern>*</pattern>
        <template>I did not understand that query. Try asking something like: Who is the father of Hassan? or siblings of Hassan or ancestors of Usman.</template>
    </category>

</aiml>
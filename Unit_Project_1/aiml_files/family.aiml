    <!-- LISTS -->
    <category>
        <pattern>LIST ALL MALES</pattern>
        <template>QUERY:male(X)</template>
    </category>
    <category>
        <pattern>SHOW ALL MALES</pattern>
        <template>QUERY:male(X)</template>
    </category>

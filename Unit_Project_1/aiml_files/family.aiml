<?xml version="1.0" encoding="UTF-8"?>
<aiml version="1.0.1" encoding="UTF-8">

    <!-- GREETINGS -->
    <category>
        <pattern>HELLO</pattern>
        <template>Hello! I am the Prolog-based Family Knowledge Base Assistant. Ask me relationship queries, and I will resolve them using Prolog inference rules. Type HELP to see examples.</template>
    </category>
    <category>
        <pattern>HI</pattern>
        <template><srai>HELLO</srai></template>
    </category>
    <category>
        <pattern>HEY</pattern>
        <template><srai>HELLO</srai></template>
    </category>
    <category>
        <pattern>HELP</pattern>
        <template>You can ask me questions like:
- Who is the father of Hassan?
- Who are the siblings of Usman?
- Who is the grandfather of Bilal?
- When was Sana born?
- Is Hassan older than Usman?
- Who is the uncle of Bilal?
- Who are the cousins of Usman?
- Who are the ancestors of Usman?
- Is Hassan married?
- Does Ali have children?
- List all males / List all females</template>
    </category>

    <!-- FATHER -->
    <category>
        <pattern>WHO IS THE FATHER OF *</pattern>
        <template>QUERY:father(X, <star/>)</template>
    </category>
    <category>
        <pattern>WHO IS FATHER OF *</pattern>
        <template>QUERY:father(X, <star/>)</template>
    </category>
    <category>
        <pattern>WHAT IS THE FATHER OF *</pattern>
        <template>QUERY:father(X, <star/>)</template>
    </category>
    <category>
        <pattern>TELL ME THE FATHER OF *</pattern>
        <template>QUERY:father(X, <star/>)</template>
    </category>
    <category>
        <pattern>WHO IS * FATHER</pattern>
        <template>QUERY:father(X, <star/>)</template>
    </category>
    <category>
        <pattern>FATHER OF *</pattern>
        <template>QUERY:father(X, <star/>)</template>
    </category>

